      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "ambiance-spring" }],
      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project-ambiance-autumn", "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project",
      "has": [{ "type": "query", "key": "id", "value": "ambiance-autumn" }],
      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "ambiance-autumn" }],
      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project-ambiance-hue", "destination": "/", "permanent": true },
