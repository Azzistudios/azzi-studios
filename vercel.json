    { "source": "/project-blubay-nightlife", "destination": "/", "permanent": true },
    { "source": "/work", "destination": "/", "permanent": true },
    { "source": "/project-eirene-identity", "destination": "/", "permanent": true },
    { "source": "/project-ambiance-winter", "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project",
      "has": [{ "type": "query", "key": "id", "value": "ambiance-winter" }],
      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project.html",
      "has": [{ "type": "query", "key": "id", "value": "ambiance-winter" }],
      "destination": "/project-ambiance-seasons", "permanent": true },
    { "source": "/project-ambiance-summer", "destination": "/project-ambiance-seasons", "permanent": true },
